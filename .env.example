# =============================================================================
# AI-Powered RAG Discovery Engine — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API credentials
# cp .env.example .env
# =============================================================================

# --- Reddit API (PRAW) ---
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MyntraRAG/0.1 by YourUsername

# --- YouTube Data API v3 ---
# Get key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key

# --- X (Twitter) API v2 ---
# Get bearer token at: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# --- Instagram ---
# Option 1: Instagram Graph API (requires Facebook Developer account)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id
# Option 2: Instaloader (no API key needed, uses public scraping)
INSTAGRAM_USE_INSTALOADER=true

# --- Play Store ---
# No API key required — google-play-scraper uses public endpoints

# --- App Store ---
# No API key required — app-store-scraper uses public endpoints

# --- Database (Phase 2) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=myntra_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- ChromaDB (Phase 3) ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# --- Redis (Phase 2) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- General Config ---
# Maximum records to fetch per scraper run (default)
DEFAULT_MAX_RECORDS=500
# Output directory for raw JSONL files
RAW_DATA_DIR=data/raw
# Log level
LOG_LEVEL=INFO
